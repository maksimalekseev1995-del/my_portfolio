{
  // Cloudflare Workers: static site + a small Worker that adds Range support
  // for videos (needed for seeking). See worker.js.
  "name": "my-portfolio",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/*"]
  }
}
